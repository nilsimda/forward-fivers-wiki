---
import WikiLayout from '../layouts/WikiLayout.astro';
import items from '../data/generated/items.json';
import monsterDrops from '../data/generated/monster-drops.json';
const baseUrl = import.meta.env.BASE_URL;
const basePath = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (targetPath: string) => `${basePath}${targetPath.replace(/^\//, '')}`;
---

<WikiLayout title="MHFG1 Wiki">
  <section class="space-y-4">
    <h1>Monster Hunter Frontier G1 Wiki</h1>
    <p class="max-w-3xl text-slate-300">
      Data-first static wiki for MHFG G1. This site is generated from extracted game data
      in <code>g1_data</code>; Ferias is used only as structure inspiration.
    </p>
  </section>

  <section class="mt-8 grid gap-4 md:grid-cols-3">
    <article class="panel">
      <h2 class="text-lg">Items</h2>
      <p class="mt-2 text-slate-400">Browse all extracted in-game items with details and pricing.</p>
      <p class="mt-3 text-2xl font-semibold text-cyan-200">{items.length}</p>
      <a class="mt-4 inline-block" href={withBase('items/')}>Open item index</a>
    </article>
    <article class="panel">
      <h2 class="text-lg">Monster Drops</h2>
      <p class="mt-2 text-slate-400">Explore part break, capture, and rank-specific drop entries.</p>
      <p class="mt-3 text-2xl font-semibold text-cyan-200">{monsterDrops.length}</p>
      <a class="mt-4 inline-block" href={withBase('monster-drops/')}>Open monster drops</a>
    </article>
    <article class="panel">
      <h2 class="text-lg">Data Provenance</h2>
      <p class="mt-2 text-slate-400">See extraction source, caveats, and update flow for contributors.</p>
      <a class="mt-4 inline-block" href={withBase('about-data/')}>Read details</a>
    </article>
  </section>
</WikiLayout>
