---
import WikiLayout from "../../layouts/WikiLayout.astro";
import { getCollection } from "astro:content";

const allCarves = await getCollection("monsterCarves");

const carves = allCarves
  .filter(
    (entry) =>
      entry.data.lr_cts.length > 0 ||
      entry.data.hr_cts.length > 0 ||
      entry.data.er_cts.length > 0 ||
      entry.data.gr_cts.length > 0,
  )
  .sort((a, b) => a.data.id - b.data.id);

const rankLabels: Record<string, string> = {
  lr_cts: "Low Rank",
  hr_cts: "High Rank",
  er_cts: "Elite Rank",
  gr_cts: "G Rank",
};

const getAvailableRanks = (entry: (typeof carves)[0]["data"]) => {
  const ranks: string[] = [];
  if (entry.lr_cts.length > 0) ranks.push(rankLabels.lr_cts);
  if (entry.hr_cts.length > 0) ranks.push(rankLabels.hr_cts);
  if (entry.er_cts.length > 0) ranks.push(rankLabels.er_cts);
  if (entry.gr_cts.length > 0) ranks.push(rankLabels.gr_cts);
  return ranks;
};

const baseUrl = import.meta.env.BASE_URL;
const basePath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const withBase = (targetPath: string) =>
  `${basePath}${targetPath.replace(/^\//, "")}`;
---

<WikiLayout title="Monster Drops | MHFG1 Wiki">
  <section class="space-y-2">
    <h1>Monster Drop Tables</h1>
    <p class="text-slate-300">Search by monster name or ID.</p>
  </section>

  <section class="panel mt-6 space-y-3">
    <label class="block text-sm font-medium text-slate-200" for="monster-search"
      >Search monsters</label
    >
    <input
      id="monster-search"
      type="search"
      placeholder="Monster name, ID, rank, or drop mode..."
      class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100"
    />
    <p class="text-sm text-slate-400">
      Showing <span id="visible-monster-count">{carves.length}</span> of {
        carves.length
      } monsters
    </p>
  </section>

  <div class="table-wrap mt-6">
    <table class="table-grid">
      <thead>
        <tr>
          <th>ID</th>
          <th>Monster</th>
          <th>Ranks</th>
        </tr>
      </thead>
      <tbody>
        {
          carves.map((entry) => {
            const ranks = getAvailableRanks(entry.data);
            return (
              <tr
                data-monster-row
                data-monster-id={String(entry.data.id)}
                data-monster-name={entry.data.monster_name.toLowerCase()}
              >
                <td>{entry.data.id}</td>
                <td>
                  <a href={withBase(`monster-drops/${entry.data.id}/`)}>
                    {entry.data.monster_name}
                  </a>
                </td>
                <td>{ranks.join(", ")}</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  <script>
    const input = document.querySelector<HTMLInputElement>("#monster-search");
    const rows = Array.from(
      document.querySelectorAll<HTMLTableRowElement>("[data-monster-row]"),
    );
    const count = document.querySelector<HTMLElement>("#visible-monster-count");

    const update = () => {
      const query = (input?.value || "").trim().toLowerCase();
      let shown = 0;

      for (const row of rows) {
        const id = row.dataset.monsterId || "";
        const name = row.dataset.monsterName || "";
        const show = !query || id.includes(query) || name.includes(query);
        row.style.display = show ? "" : "none";
        if (show) shown += 1;
      }

      if (count) {
        count.textContent = String(shown);
      }
    };

    input?.addEventListener("input", update);
  </script>
</WikiLayout>
