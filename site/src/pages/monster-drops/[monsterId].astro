---
import WikiLayout from "../../layouts/WikiLayout.astro";
import MonsterDropTable from "../../components/MonsterDropTable.astro";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
  const monsterCarves = await getCollection("monsterCarves");

  return monsterCarves.map((entry) => ({
    params: { monsterId: String(entry.id) },
    props: { monsterId: entry.id },
  }));
}

const { monsterId } = Astro.props;

const carves = await getEntry("monsterCarves", monsterId);
if (!carves) throw new Error(`No carves found for monster ${monsterId}`);
const partbreaks = await getEntry("monsterPartbreaks", monsterId);

const monsterName = carves.data.monster_name;

const baseUrl = import.meta.env.BASE_URL;
const basePath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const withBase = (targetPath: string) =>
  `${basePath}${targetPath.replace(/^\//, "")}`;

const ranks = [
  { rank: "lr" as const, label: "Low Rank" },
  { rank: "hr" as const, label: "High Rank" },
  { rank: "er" as const, label: "Elite Rank" },
  { rank: "gr" as const, label: "G-Rank" },
];
---

<WikiLayout title={`${monsterName} Drops | MHFG1 Wiki`}>
  <article class="space-y-6">
    <header class="space-y-2">
      <a href={withBase("monster-drops/")} class="text-sm"
        >Back to monster drop index</a
      >
      <h1>
        {monsterName} Drops
        <span class="text-slate-500"> (#{monsterId})</span>
      </h1>
    </header>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        ranks.map(
          ({ rank, label }) =>
            carves.data[`${rank}_cts`].length > 0 && (
              <MonsterDropTable
                rank={rank}
                rankLabel={label}
                carves={carves}
                partbreaks={partbreaks}
                withBase={withBase}
              />
            ),
        )
      }
    </div>
  </article>
</WikiLayout>
