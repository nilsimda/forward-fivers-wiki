---
import WikiLayout from '../../layouts/WikiLayout.astro';
import questRewards from '../../data/generated/quest-rewards.json';

type RewardEntry = {
  rewardBoxId: number;
  rewardBoxNumber?: number;
  itemId: number;
  itemName: string;
  percentChance: number;
  itemCount: number;
};

type QuestPage = {
  questId: number;
  slug: string;
  title: string;
  rank: string;
  questRank: number;
  joinMinRank: number;
  postMinRank: number;
  maxPlayers: number;
  questFee: number;
  zennyReward: number;
  zennyKO: number;
  zennySubA: number;
  zennySubB: number;
  questTimeFrames: number;
  mapID: number;
  contractor: string;
  description: string;
  mainObjective: string;
  subObjectiveA: string;
  subObjectiveB: string;
  successCondition: string;
  failCondition: string;
  mainGoal: unknown;
  subAGoal: unknown;
  subBGoal: unknown;
  questRewards?: RewardEntry[];
  rewardGroups?: Array<{ rewards?: RewardEntry[] }>;
};

export function getStaticPaths() {
  return (questRewards as QuestPage[]).map((quest) => ({
    params: { slug: quest.slug },
    props: { quest }
  }));
}

const { quest } = Astro.props as { quest: QuestPage };
const baseUrl = import.meta.env.BASE_URL;
const basePath = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (targetPath: string) => `${basePath}${targetPath.replace(/^\//, '')}`;
const formatRewardBoxLabel = (rewardBoxNumber: number) => {
  if (rewardBoxNumber === 1) return 'Main Reward';
  if (rewardBoxNumber === 2) return 'Subquest A Reward';
  if (rewardBoxNumber === 3) return 'Subquest B Reward';
  return `Reward Box ${rewardBoxNumber}`;
};

const getQuestRewards = (value: QuestPage): RewardEntry[] => {
  if (Array.isArray(value.questRewards)) return value.questRewards;
  if (!Array.isArray(value.rewardGroups)) return [];
  return value.rewardGroups.flatMap((group) => (Array.isArray(group.rewards) ? group.rewards : []));
};

const groupedRewardsByBox = (rewards: RewardEntry[]) => {
  const byBox = new Map<number, { rewardBoxNumber: number; rewards: RewardEntry[] }>();

  for (const reward of rewards) {
    const rewardBoxNumber = typeof reward.rewardBoxNumber === 'number' ? reward.rewardBoxNumber : reward.rewardBoxId + 1;
    if (!byBox.has(reward.rewardBoxId)) byBox.set(reward.rewardBoxId, { rewardBoxNumber, rewards: [] });
    const bucket = byBox.get(reward.rewardBoxId);
    if (!bucket) continue;
    bucket.rewards.push(reward);
  }

  return [...byBox.entries()]
    .map(([rewardBoxId, box]) => ({
      rewardBoxId,
      rewardBoxNumber: box.rewardBoxNumber,
      rewards: box.rewards
        .slice()
        .sort((a, b) => a.itemId - b.itemId)
    }))
    .sort((a, b) => a.rewardBoxId - b.rewardBoxId);
};

const renderGoal = (goal: unknown) => {
  if (!goal || typeof goal !== 'object') return 'None';
  const normalizedGoal = goal as {
    typeName?: string;
    targetKind?: string;
    target?: number | null;
    targetLabel?: string;
    count?: number | null;
    part?: string | number | null;
  };
  if (!normalizedGoal.typeName || normalizedGoal.typeName === 'None') return 'None';
  const targetChunk =
    normalizedGoal.targetLabel
      ? normalizedGoal.targetLabel
      : normalizedGoal.targetKind && normalizedGoal.target !== null && normalizedGoal.target !== undefined
        ? `${normalizedGoal.targetKind} ${normalizedGoal.target}`
      : '';
  const countChunk =
    normalizedGoal.count !== null && normalizedGoal.count !== undefined ? `x${normalizedGoal.count}` : '';
  const partChunk = normalizedGoal.part ? ` (${normalizedGoal.part})` : '';
  return [normalizedGoal.typeName, targetChunk, countChunk].filter(Boolean).join(' ') + partChunk;
};

const questRewardsRows = getQuestRewards(quest);
---

<WikiLayout title={`${quest.title} | Quests | MHFG1 Wiki`}>
  <article class="space-y-6">
    <header class="space-y-2">
      <a href={withBase('quests/')} class="text-sm">Back to quest rewards</a>
      <h1>{quest.title}</h1>
      <p class="text-slate-300">Quest ID {quest.questId} | Rank {quest.rank}</p>
    </header>

    <section class="grid gap-4 md:grid-cols-2">
      <div class="panel">
        <h2 class="text-lg">Quest Details</h2>
        <dl class="mt-3 space-y-2 text-sm text-slate-300">
          <div class="flex justify-between gap-3"><dt>Quest rank code</dt><dd>{quest.questRank}</dd></div>
          <div class="flex justify-between gap-3"><dt>Join HR</dt><dd>{quest.joinMinRank}</dd></div>
          <div class="flex justify-between gap-3"><dt>Post HR</dt><dd>{quest.postMinRank}</dd></div>
          <div class="flex justify-between gap-3"><dt>Max players</dt><dd>{quest.maxPlayers}</dd></div>
          <div class="flex justify-between gap-3"><dt>Map ID</dt><dd>{quest.mapID}</dd></div>
          <div class="flex justify-between gap-3"><dt>Time frames</dt><dd>{quest.questTimeFrames}</dd></div>
        </dl>
      </div>
      <div class="panel">
        <h2 class="text-lg">Rewards and Fees</h2>
        <dl class="mt-3 space-y-2 text-sm text-slate-300">
          <div class="flex justify-between gap-3"><dt>Quest fee</dt><dd>{quest.questFee}z</dd></div>
          <div class="flex justify-between gap-3"><dt>Main reward</dt><dd>{quest.zennyReward}z</dd></div>
          <div class="flex justify-between gap-3"><dt>KO penalty</dt><dd>-{quest.zennyKO}z</dd></div>
          <div class="flex justify-between gap-3"><dt>Sub A reward</dt><dd>{quest.zennySubA}z</dd></div>
          <div class="flex justify-between gap-3"><dt>Sub B reward</dt><dd>{quest.zennySubB}z</dd></div>
        </dl>
      </div>
    </section>

    <section class="panel space-y-3">
      <h2 class="text-lg">Description and Objectives</h2>
      <dl class="space-y-2 text-sm text-slate-300">
        <div class="grid gap-1"><dt class="text-slate-200">Contractor</dt><dd>{quest.contractor || 'Unknown'}</dd></div>
        <div class="grid gap-1"><dt class="text-slate-200">Description</dt><dd class="whitespace-pre-line">{quest.description || 'None'}</dd></div>
        <div class="grid gap-1"><dt class="text-slate-200">Main objective</dt><dd>{quest.mainObjective || 'None'}</dd></div>
        <div class="grid gap-1"><dt class="text-slate-200">Sub A objective</dt><dd>{quest.subObjectiveA || 'None'}</dd></div>
        <div class="grid gap-1"><dt class="text-slate-200">Sub B objective</dt><dd>{quest.subObjectiveB || 'None'}</dd></div>
        <div class="grid gap-1"><dt class="text-slate-200">Success condition</dt><dd class="whitespace-pre-line">{quest.successCondition || 'None'}</dd></div>
        <div class="grid gap-1"><dt class="text-slate-200">Fail condition</dt><dd class="whitespace-pre-line">{quest.failCondition || 'None'}</dd></div>
      </dl>
    </section>

    <section class="panel space-y-3">
      <h2 class="text-lg">Goal Data</h2>
      <ul class="list-disc space-y-1 pl-5 text-slate-300">
        <li><span class="text-slate-200">Main goal:</span> {renderGoal(quest.mainGoal)}</li>
        <li><span class="text-slate-200">Sub A goal:</span> {renderGoal(quest.subAGoal)}</li>
        <li><span class="text-slate-200">Sub B goal:</span> {renderGoal(quest.subBGoal)}</li>
      </ul>
    </section>

    {questRewardsRows.length === 0 ? (
      <section class="panel">
        <p class="text-slate-300">No reward data available for this quest yet.</p>
      </section>
    ) : (
      <section class="panel space-y-3">
        <h2 class="text-lg">Quest Rewards</h2>
        {groupedRewardsByBox(questRewardsRows).map((boxGroup) => (
          <div class="table-wrap">
            <table class="table-grid">
              <thead>
                <tr>
                  <th colspan={3}>{formatRewardBoxLabel(boxGroup.rewardBoxNumber)}</th>
                </tr>
                <tr>
                  <th>Item</th>
                  <th>Chance</th>
                  <th>Qty</th>
                </tr>
              </thead>
              <tbody>
                {boxGroup.rewards.map((reward) => (
                  <tr>
                    <td>
                      <a href={withBase(`items/${reward.itemId}/`)}>{reward.itemName}</a>
                    </td>
                    <td>{reward.percentChance}%</td>
                    <td>x{reward.itemCount}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </section>
    )}
  </article>
</WikiLayout>
