---
import WikiLayout from "../../layouts/WikiLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import GatheringRankTable from "../../components/GatheringRankTable.astro";
import fs from "node:fs";

type GatheringMapData = CollectionEntry<"gathering">["data"];
type GatheringRankKey = keyof GatheringMapData["ranks"];
type SeasonKey = "spring" | "summer" | "winter";

const rankMeta: Record<
  GatheringRankKey,
  { label: string; panel: string; pill: string }
> = {
  lr: {
    label: "LR (Low Rank)",
    panel: "rank-panel--lr",
    pill: "rank-pill--active-lr",
  },
  hr: {
    label: "HR (High Rank)",
    panel: "rank-panel--hr",
    pill: "rank-pill--active-hr",
  },
  er: {
    label: "ER (Elite Rank)",
    panel: "rank-panel--er",
    pill: "rank-pill--active-er",
  },
  gr: {
    label: "GR (G Rank)",
    panel: "rank-panel--gr",
    pill: "rank-pill--active-gr",
  },
};

const seasonMeta: Record<SeasonKey, { label: string }> = {
  spring: { label: "Spring" },
  summer: { label: "Summer" },
  winter: { label: "Winter" },
};

const baseUrl = import.meta.env.BASE_URL;
const basePath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const withBase = (targetPath: string) =>
  `${basePath}${targetPath.replace(/^\//, "")}`;

export async function getStaticPaths() {
  const gatheringMaps = await getCollection("gathering");
  const slugForMap = (mapId: string) =>
    mapId
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

  return gatheringMaps.map((mapEntry) => ({
    params: { mapId: slugForMap(mapEntry.data.id) },
    props: { mapData: mapEntry.data },
  }));
}

const { mapData } = Astro.props as { mapData: GatheringMapData };
const mapSlug = Astro.params.mapId!;
const overviewPath = `public/img/gathering/${mapSlug}/overview.png`;
const hasOverview = fs.existsSync(overviewPath);
const seasonOrder: SeasonKey[] = ["spring", "summer", "winter"];
const emptySeasonSlots = () => ({ spring: [], summer: [], winter: [] });
const rankSections = (Object.keys(rankMeta) as GatheringRankKey[])
  .map((rank) => {
    const slots = mapData.ranks[rank];
    return {
      rank,
      ...rankMeta[rank],
      day: slots?.day ?? emptySeasonSlots(),
      night: slots?.night ?? emptySeasonSlots(),
    };
  })
  .filter((s) =>
    seasonOrder.some(
      (season) => s.day[season].length > 0 || s.night[season].length > 0,
    ),
  );
const defaultRank = rankSections.some((s) => s.rank === "lr")
  ? "lr"
  : rankSections[0]?.rank;
const defaultSeason: SeasonKey = "spring";

const countGps = (areas: (typeof rankSections)[number]["day"][SeasonKey]) =>
  areas.reduce((sum, a) => sum + a.gps.length, 0);
const totalPoints = rankSections.reduce(
  (sum, s) =>
    sum +
    Math.max(
      ...seasonOrder.flatMap((season) => [
        countGps(s.day[season]),
        countGps(s.night[season]),
      ]),
    ),
  0,
);
---

<WikiLayout title={`${mapData.id} | Gatherables | MHFG1 Wiki`}>
  <article class="space-y-6">
    <header class="space-y-2">
      <a href={withBase("gathering/")} class="text-sm">Back to Gatherables Index</a>
      <div class="flex items-start gap-6">
        <div class="flex flex-1 flex-col self-stretch">
          <h1>{mapData.id}</h1>
          <p class="text-slate-300">
            {totalPoints} gathering nodes{totalPoints === 1 ? "" : "s"} across all
            extracted rank tables.
          </p>
          <div class="mt-auto flex flex-col gap-1 text-sm text-slate-300">
            <span class="flex items-center gap-1.5"><span class="inline-block size-3 rounded-full bg-white"></span> Gathering</span>
            <span class="flex items-center gap-1.5"><span class="inline-block size-3 rounded-full bg-yellow-400"></span> Bug Catching</span>
            <span class="flex items-center gap-1.5"><span class="inline-block size-3 rounded-full bg-red-500"></span> Mining</span>
            <span class="flex items-center gap-1.5"><span class="inline-block size-3 rounded-full bg-blue-500"></span> Fishing</span>
          </div>
        </div>
        {hasOverview && (
          <img
            src={withBase(`img/gathering/${mapSlug}/overview.png`)}
            alt={`${mapData.id} map overview`}
            class="w-48 rounded border border-slate-700"
            loading="lazy"
          />
        )}
      </div>
    </header>

    {rankSections.length === 0 ? (
      <section class="panel">
        <p class="text-slate-300">No gathering nodes found for this map.</p>
      </section>
    ) : (
      <div class="space-y-4">
        <div>
          <div class="mt-4 flex flex-wrap items-center gap-4">
            <div
              id="gathering-rank-filter"
              class="flex flex-wrap gap-2"
              data-default-rank={defaultRank}
            >
              {rankSections.map((section) => (
                <button
                  type="button"
                  class={`rank-pill ${section.rank === defaultRank ? section.pill : ""}`}
                  data-rank-filter={section.rank}
                  data-rank-active-class={section.pill}
                >
                  {section.label}
                </button>
              ))}
            </div>

            <div
              id="gathering-season-filter"
              class="flex gap-1 rounded-lg bg-slate-800 p-1"
              data-default-season={defaultSeason}
            >
              {seasonOrder.map((season) => (
                <button
                  type="button"
                  class={`rounded-md px-3 py-1 text-sm ${season === defaultSeason ? "bg-slate-600 text-white" : "text-slate-400"}`}
                  data-season-filter={season}
                >
                  {seasonMeta[season].label}
                </button>
              ))}
            </div>
            <div id="gathering-time-filter" class="flex gap-1 rounded-lg bg-slate-800 p-1">
              <button
                type="button"
                class="rounded-md px-3 py-1 text-sm bg-slate-600 text-white"
                data-time-filter="day"
              >Day</button>
              <button
                type="button"
                class="rounded-md px-3 py-1 text-sm text-slate-400"
                data-time-filter="night"
              >Night</button>
            </div>
          </div>
        </div>

        {rankSections.map((section) => (
          <section
            class={`panel rank-panel ${section.panel} ${section.rank === defaultRank ? "" : "hidden"}`}
            data-rank-section={section.rank}
          >
            {(["day", "night"] as const).map((time) =>
              seasonOrder.map((season) => (
                <div
                  data-slot-section
                  data-time-section={time}
                  data-season-section={season}
                  class="hidden"
                >
                  {section[time][season].length > 0 ? (
                    <GatheringRankTable
                      rank={section.rank}
                      rankLabel={section.label}
                      areas={section[time][season]}
                      mapSlug={mapSlug}
                      time={time}
                      withBase={withBase}
                    />
                  ) : (
                    <p class="text-slate-400 text-sm py-4">
                      No {time === "day" ? "daytime" : "nighttime"} {seasonMeta[season].label.toLowerCase()} gathering data for this rank.
                    </p>
                  )}
                </div>
              ))
            )}
          </section>
        ))}
      </div>
    )}
  </article>
</WikiLayout>

<script>
  (() => {
    const rankRoot = document.getElementById("gathering-rank-filter");
    const timeRoot = document.getElementById("gathering-time-filter");
    const seasonRoot = document.getElementById("gathering-season-filter");
    if (!rankRoot) return;

    const rankButtons = Array.from(
      rankRoot.querySelectorAll("[data-rank-filter]"),
    ) as HTMLElement[];
    const rankSections = Array.from(
      document.querySelectorAll("[data-rank-section]"),
    ) as HTMLElement[];
    const timeButtons = timeRoot
      ? (Array.from(timeRoot.querySelectorAll("[data-time-filter]")) as HTMLElement[])
      : [];
    const seasonButtons = seasonRoot
      ? (Array.from(seasonRoot.querySelectorAll("[data-season-filter]")) as HTMLElement[])
      : [];
    const slotSections = Array.from(
      document.querySelectorAll("[data-slot-section]"),
    ) as HTMLElement[];

    let activeTime = "day";
    let activeSeason = (seasonRoot?.dataset.defaultSeason || "spring") as
      | "spring"
      | "summer"
      | "winter";

    const applyRank = (rank: string) => {
      rankSections.forEach((s) =>
        s.classList.toggle("hidden", s.dataset.rankSection !== rank),
      );
      rankButtons.forEach((b) => {
        const cls = b.dataset.rankActiveClass;
        if (cls) b.classList.toggle(cls, b.dataset.rankFilter === rank);
      });
    };

    const applySlotVisibility = () => {
      slotSections.forEach((slot) => {
        const slotTime = slot.dataset.timeSection;
        const slotSeason = slot.dataset.seasonSection;
        slot.classList.toggle(
          "hidden",
          slotTime !== activeTime || slotSeason !== activeSeason,
        );
      });
    };

    const applyTime = (time: string) => {
      activeTime = time;
      applySlotVisibility();
      timeButtons.forEach((b) => {
        const active = b.dataset.timeFilter === time;
        b.classList.toggle("bg-slate-600", active);
        b.classList.toggle("text-white", active);
        b.classList.toggle("text-slate-400", !active);
      });
    };

    const applySeason = (season: "spring" | "summer" | "winter") => {
      activeSeason = season;
      applySlotVisibility();
      seasonButtons.forEach((b) => {
        const active = b.dataset.seasonFilter === season;
        b.classList.toggle("bg-slate-600", active);
        b.classList.toggle("text-white", active);
        b.classList.toggle("text-slate-400", !active);
      });
    };

    rankButtons.forEach((b) =>
      b.addEventListener("click", () => {
        if (b.dataset.rankFilter) applyRank(b.dataset.rankFilter);
      }),
    );
    timeButtons.forEach((b) =>
      b.addEventListener("click", () => {
        if (b.dataset.timeFilter) applyTime(b.dataset.timeFilter);
      }),
    );
    seasonButtons.forEach((b) =>
      b.addEventListener("click", () => {
        const season = b.dataset.seasonFilter as "spring" | "summer" | "winter";
        if (season) applySeason(season);
      }),
    );

    const initialRank = rankRoot.dataset.defaultRank;
    if (initialRank) applyRank(initialRank);
    applyTime("day");
    applySeason(activeSeason);
  })();

</script>
