---
import WikiLayout from "../../layouts/WikiLayout.astro";
import { getCollection } from "astro:content";

const baseUrl = import.meta.env.BASE_URL;
const basePath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const withBase = (targetPath: string) =>
  `${basePath}${targetPath.replace(/^\//, "")}`;

const allItems = await getCollection("items");
const sortedItems = allItems
  .map((entry) => entry.data)
  .sort((a, b) => a.id - b.id);
---

<WikiLayout title="Items | MHFG1 Wiki">
  <section class="space-y-2">
    <h1>Item Index</h1>
    <p class="text-slate-300">
      {sortedItems.length} extracted item records from the G1 game data files.
    </p>
  </section>

  <section class="panel mt-6 space-y-3">
    <label class="block text-sm font-medium text-slate-200" for="item-search">
      Search items
    </label>
    <input
      id="item-search"
      type="search"
      placeholder="Name, description, or item ID..."
      class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100"
    />
    <div class="flex items-center justify-between text-sm text-slate-400">
      <span>
        Showing <span id="match-count">{sortedItems.length}</span> of {sortedItems.length} items
      </span>
      <span id="page-info"></span>
    </div>
  </section>

  <div class="table-wrap mt-6">
    <table class="table-grid">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Rarity</th>
          <th>Buy</th>
          <th>Sell</th>
        </tr>
      </thead>
      <tbody>
        {
          sortedItems.map((item) => (
            <tr
              data-item-row
              data-item-id={String(item.id)}
              data-item-name={item.name.toLowerCase()}
              data-item-desc={item.description.toLowerCase()}
            >
              <td>{item.id}</td>
              <td>
                <a href={withBase(`items/${item.id}/`)}>{item.name}</a>
              </td>
              <td>{item.rarity + 1}</td>
              <td>
                {item.buy_price}{item.is_gz ? "Gz" : "z"}
              </td>
              <td>
                {item.sell_price}{item.is_gz ? "Gz" : "z"}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <nav class="mt-6 flex items-center justify-between text-sm" aria-label="Pagination">
    <div class="flex gap-2">
      <button id="page-first" type="button" class="pagination-btn" disabled>&laquo; First</button>
      <button id="page-prev" type="button" class="pagination-btn" disabled>&lsaquo; Prev</button>
    </div>
    <span id="page-nav-info" class="text-slate-400"></span>
    <div class="flex gap-2">
      <button id="page-next" type="button" class="pagination-btn">Next &rsaquo;</button>
      <button id="page-last" type="button" class="pagination-btn">Last &raquo;</button>
    </div>
  </nav>

  <script>
    const PAGE_SIZE = 100;
    const input = document.querySelector<HTMLInputElement>("#item-search");
    const rows = Array.from(
      document.querySelectorAll<HTMLTableRowElement>("[data-item-row]"),
    );
    const matchCount = document.querySelector<HTMLElement>("#match-count");
    const pageInfo = document.querySelector<HTMLElement>("#page-info");
    const pageNavInfo = document.querySelector<HTMLElement>("#page-nav-info");
    const firstBtn = document.querySelector<HTMLButtonElement>("#page-first");
    const prevBtn = document.querySelector<HTMLButtonElement>("#page-prev");
    const nextBtn = document.querySelector<HTMLButtonElement>("#page-next");
    const lastBtn = document.querySelector<HTMLButtonElement>("#page-last");

    let currentPage = 1;

    function getFiltered(): HTMLTableRowElement[] {
      const q = (input?.value || "").trim().toLowerCase();
      if (!q) return rows;
      return rows.filter((r) => {
        const id = r.dataset.itemId || "";
        const name = r.dataset.itemName || "";
        const desc = r.dataset.itemDesc || "";
        return id.includes(q) || name.includes(q) || desc.includes(q);
      });
    }

    function update() {
      const filtered = getFiltered();
      const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
      if (currentPage > totalPages) currentPage = totalPages;

      const start = (currentPage - 1) * PAGE_SIZE;
      const visible = new Set(filtered.slice(start, start + PAGE_SIZE));

      for (const row of rows) row.style.display = visible.has(row) ? "" : "none";

      if (matchCount) matchCount.textContent = String(filtered.length);
      const label = `Page ${currentPage} of ${totalPages}`;
      if (pageInfo) pageInfo.textContent = label;
      if (pageNavInfo) pageNavInfo.textContent = label;

      if (firstBtn) firstBtn.disabled = currentPage <= 1;
      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
      if (lastBtn) lastBtn.disabled = currentPage >= totalPages;
    }

    input?.addEventListener("input", () => {
      currentPage = 1;
      update();
    });
    firstBtn?.addEventListener("click", () => { currentPage = 1; update(); });
    prevBtn?.addEventListener("click", () => { currentPage--; update(); });
    nextBtn?.addEventListener("click", () => { currentPage++; update(); });
    lastBtn?.addEventListener("click", () => {
      const totalPages = Math.max(1, Math.ceil(getFiltered().length / PAGE_SIZE));
      currentPage = totalPages;
      update();
    });

    update();
  </script>
</WikiLayout>
