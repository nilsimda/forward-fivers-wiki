---
import WikiLayout from '../../layouts/WikiLayout.astro';
import items from '../../data/generated/items.json';
import itemAcquisitionByItemId from '../../data/generated/item-acquisition.json';

export function getStaticPaths() {
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

const { item } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const basePath = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (targetPath: string) => `${basePath}${targetPath.replace(/^\//, '')}`;
const rankOrder = ['lr', 'hr', 'arena', 'hr100', 'gr'];
const rankLabels: Record<string, string> = {
  lr: 'LR (Low Rank)',
  hr: 'HR (High Rank)',
  arena: 'Arena',
  hr100: 'HR 100',
  gr: 'G-Rank'
};
const methodOrder = ['capture', 'part_break', 'hardcore_carve', 'quest_reward', 'carve', 'gather', 'shop'];
const methodLabels: Record<string, string> = {
  capture: 'Capture',
  part_break: 'Part Break',
  hardcore_carve: 'Hardcore Carve',
  quest_reward: 'Quest Reward',
  carve: 'Carve',
  gather: 'Gather',
  shop: 'Shop'
};

type AcquisitionMethod = {
  methodType: string;
  rank?: string;
  sourceLabel?: string;
  chance?: number;
  quantity?: number;
  monsterId?: number;
  monsterName?: string;
  partbreakType?: string;
  questId?: number;
  questSlug?: string;
  questTitle?: string;
  questVariantLabel?: string;
  rewardBoxId?: number;
  rewardBoxNumber?: number;
};

type ItemAcquisitionEntry = {
  itemId: number;
  itemName: string;
  methods: AcquisitionMethod[];
};

type DescriptionSegment = {
  text: string;
  colorCode: string | null;
};

type QuestRewardGroup = {
  questKey: string;
  questTitle: string;
  questId?: number;
  questSlug?: string;
  methods: AcquisitionMethod[];
};

type MonsterMethodGroup = {
  monsterKey: string;
  monsterName: string;
  monsterId?: number;
  methods: AcquisitionMethod[];
};

type MonsterRankGroup = {
  rank: string;
  monsters: MonsterMethodGroup[];
};

const acquisitionEntry = (itemAcquisitionByItemId as Record<string, ItemAcquisitionEntry>)[String(item.id)];
const acquisitionMethods = acquisitionEntry?.methods || [];
const descriptionSegments: DescriptionSegment[] = Array.isArray(item.descriptionSegments)
  ? item.descriptionSegments
  : [];
const fallbackDescription = item.descriptionPlain || item.description || '';
if (descriptionSegments.length === 0 && fallbackDescription) {
  descriptionSegments.push({ text: fallbackDescription, colorCode: null });
}
const descriptionColorClassByCode: Record<string, string> = {
  '05': 'text-amber-300'
};
const getDescriptionSegmentClass = (colorCode: string | null) =>
  colorCode ? descriptionColorClassByCode[colorCode] || 'text-slate-300' : 'text-slate-300';
const currencyUnit = item.isGz ? 'Gz' : 'z';
const formatRewardBoxLabel = (rewardBoxNumber: number) => {
  if (rewardBoxNumber === 1) return 'Main Reward';
  if (rewardBoxNumber === 2) return 'Subquest A Reward';
  if (rewardBoxNumber === 3) return 'Subquest B Reward';
  return `Reward Box ${rewardBoxNumber}`;
};

const getRewardBoxNumber = (method: AcquisitionMethod) => {
  if (typeof method.rewardBoxNumber === 'number') return method.rewardBoxNumber;
  if (typeof method.rewardBoxId === 'number') return method.rewardBoxId + 1;
  return null;
};
const getRewardBoxLabel = (method: AcquisitionMethod) => {
  const rewardBoxNumber = getRewardBoxNumber(method);
  if (rewardBoxNumber === null) return 'Reward Box';
  return formatRewardBoxLabel(rewardBoxNumber);
};

const monsterMethodTypes = new Set(['capture', 'part_break', 'hardcore_carve', 'carve']);
const groupedMethodsMap = new Map<string, { rank: string; methodType: string; methods: AcquisitionMethod[] }>();

for (const method of acquisitionMethods) {
  if (monsterMethodTypes.has(method.methodType || '')) {
    continue;
  }
  const rank = method.rank || 'unknown';
  const methodType = method.methodType || 'unknown';
  const key = `${rank}::${methodType}`;

  if (!groupedMethodsMap.has(key)) {
    groupedMethodsMap.set(key, { rank, methodType, methods: [] });
  }

  const group = groupedMethodsMap.get(key);
  if (!group) continue;
  group.methods.push(method);
}

const groupedMethods = [...groupedMethodsMap.values()].sort((a, b) => {
  const rankA = rankOrder.indexOf(a.rank);
  const rankB = rankOrder.indexOf(b.rank);
  const safeRankA = rankA === -1 ? Number.MAX_SAFE_INTEGER : rankA;
  const safeRankB = rankB === -1 ? Number.MAX_SAFE_INTEGER : rankB;
  if (safeRankA !== safeRankB) return safeRankA - safeRankB;

  const methodA = methodOrder.indexOf(a.methodType);
  const methodB = methodOrder.indexOf(b.methodType);
  const safeMethodA = methodA === -1 ? Number.MAX_SAFE_INTEGER : methodA;
  const safeMethodB = methodB === -1 ? Number.MAX_SAFE_INTEGER : methodB;
  if (safeMethodA !== safeMethodB) return safeMethodA - safeMethodB;

  return a.methodType.localeCompare(b.methodType);
});

const groupMonsterMethodsByRank = (methods: AcquisitionMethod[]): MonsterRankGroup[] => {
  const rankMap = new Map<string, Map<string, MonsterMethodGroup>>();

  for (const method of methods) {
    if (!monsterMethodTypes.has(method.methodType || '')) continue;
    const rank = method.rank || 'unknown';
    const monsterName = method.monsterName || method.sourceLabel || 'Unknown monster';
    const monsterKey = typeof method.monsterId === 'number' ? `id:${method.monsterId}` : monsterName;

    if (!rankMap.has(rank)) {
      rankMap.set(rank, new Map<string, MonsterMethodGroup>());
    }
    const monstersForRank = rankMap.get(rank);
    if (!monstersForRank) continue;

    if (!monstersForRank.has(monsterKey)) {
      monstersForRank.set(monsterKey, {
        monsterKey,
        monsterName,
        monsterId: method.monsterId,
        methods: []
      });
    }
    const monsterGroup = monstersForRank.get(monsterKey);
    if (!monsterGroup) continue;
    monsterGroup.methods.push(method);
  }

  return [...rankMap.entries()]
    .map(([rank, monstersMap]) => ({
      rank,
      monsters: [...monstersMap.values()]
        .map((monsterGroup) => ({
          ...monsterGroup,
          methods: [...monsterGroup.methods].sort((a, b) => {
            const methodA = methodOrder.indexOf(a.methodType || '');
            const methodB = methodOrder.indexOf(b.methodType || '');
            const safeMethodA = methodA === -1 ? Number.MAX_SAFE_INTEGER : methodA;
            const safeMethodB = methodB === -1 ? Number.MAX_SAFE_INTEGER : methodB;
            if (safeMethodA !== safeMethodB) return safeMethodA - safeMethodB;
            const chanceA = typeof a.chance === 'number' ? a.chance : -1;
            const chanceB = typeof b.chance === 'number' ? b.chance : -1;
            if (chanceA !== chanceB) return chanceB - chanceA;
            return (a.sourceLabel || '').localeCompare(b.sourceLabel || '');
          })
        }))
        .sort((a, b) => a.monsterName.localeCompare(b.monsterName))
    }))
    .sort((a, b) => {
      const rankA = rankOrder.indexOf(a.rank);
      const rankB = rankOrder.indexOf(b.rank);
      const safeRankA = rankA === -1 ? Number.MAX_SAFE_INTEGER : rankA;
      const safeRankB = rankB === -1 ? Number.MAX_SAFE_INTEGER : rankB;
      if (safeRankA !== safeRankB) return safeRankA - safeRankB;
      return a.rank.localeCompare(b.rank);
    });
};

const monsterRankGroups = groupMonsterMethodsByRank(acquisitionMethods);

const getMonsterMethodLabel = (method: AcquisitionMethod) => {
  if (method.methodType === 'capture') return 'Capture';
  if (method.methodType === 'part_break') return `Part Break: ${method.partbreakType || 'unknown'}`;
  if (method.methodType === 'hardcore_carve') return 'Hardcore Carve';
  if (method.methodType === 'carve') return method.sourceLabel || 'Carve';
  return methodLabels[method.methodType || ''] || method.methodType || 'Unknown';
};

const renderSourceLabel = (method: AcquisitionMethod) => {
  if (method.methodType === 'quest_reward') {
    const questTitle = method.questTitle || method.sourceLabel || `Quest ${method.questId || ''}`.trim();
    const questIdLabel = typeof method.questId === 'number' ? ` (#${method.questId})` : '';
    const box =
      typeof method.rewardBoxNumber === 'number'
        ? ` - ${formatRewardBoxLabel(method.rewardBoxNumber)}`
        : typeof method.rewardBoxId === 'number'
          ? ` - ${formatRewardBoxLabel(method.rewardBoxId + 1)}`
        : '';
    return `${questTitle}${questIdLabel}${box}`;
  }
  return method.sourceLabel || 'Unknown source';
};

const getSourceHref = (method: AcquisitionMethod) => {
  if (method.methodType === 'quest_reward' && method.questSlug) {
    return withBase(`quests/${method.questSlug}/`);
  }
  return null;
};

const groupQuestRewardsByQuest = (methods: AcquisitionMethod[]): QuestRewardGroup[] => {
  const questMap = new Map<string, QuestRewardGroup>();
  for (const method of methods) {
    const questKey = method.questSlug || `id:${method.questId || 'unknown'}::${method.questTitle || method.sourceLabel || 'unknown'}`;
    if (!questMap.has(questKey)) {
      questMap.set(questKey, {
        questKey,
        questTitle: method.questTitle || method.sourceLabel || `Quest ${method.questId || 'Unknown'}`,
        questId: method.questId,
        questSlug: method.questSlug,
        methods: []
      });
    }
    const questGroup = questMap.get(questKey);
    if (!questGroup) continue;
    questGroup.methods.push(method);
  }

  return [...questMap.values()]
    .map((questGroup) => ({
      ...questGroup,
      methods: [...questGroup.methods].sort((a, b) => {
        const boxA = getRewardBoxNumber(a) ?? Number.MAX_SAFE_INTEGER;
        const boxB = getRewardBoxNumber(b) ?? Number.MAX_SAFE_INTEGER;
        if (boxA !== boxB) return boxA - boxB;
        const chanceA = typeof a.chance === 'number' ? a.chance : -1;
        const chanceB = typeof b.chance === 'number' ? b.chance : -1;
        if (chanceA !== chanceB) return chanceB - chanceA;
        return 0;
      })
    }))
    .sort((a, b) => {
      const idA = typeof a.questId === 'number' ? a.questId : Number.MAX_SAFE_INTEGER;
      const idB = typeof b.questId === 'number' ? b.questId : Number.MAX_SAFE_INTEGER;
      if (idA !== idB) return idA - idB;
      return a.questTitle.localeCompare(b.questTitle);
    });
};
---

<WikiLayout title={`${item.name} | Items | MHFG1 Wiki`}>
  <article class="space-y-6">
    <header class="space-y-2">
      <a href={withBase('items/')} class="text-sm">Back to item index</a>
      <h1>{item.name}</h1>
      <p class="text-slate-300">Item ID {item.id}</p>
    </header>

    <section class="grid gap-4 md:grid-cols-2">
      <div class="panel">
        <h2 class="text-lg">Core Stats</h2>
        <dl class="mt-3 space-y-2 text-sm text-slate-300">
          <div class="flex justify-between gap-3"><dt>Rarity</dt><dd>{item.rarityPlusOne}</dd></div>
          <div class="flex justify-between gap-3"><dt>Max stack</dt><dd>{item.maxStack}</dd></div>
          <div class="flex justify-between gap-3"><dt>Buy price</dt><dd>{item.buyPrice}{currencyUnit}</dd></div>
          <div class="flex justify-between gap-3"><dt>Sell price</dt><dd>{item.sellPrice}{currencyUnit}</dd></div>
          <div class="flex justify-between gap-3"><dt>Icon</dt><dd>{item.icon}</dd></div>
          <div class="flex justify-between gap-3"><dt>Icon color</dt><dd>{item.iconColor}</dd></div>
        </dl>
      </div>
      <div class="panel">
        <h2 class="text-lg">Description</h2>
        <p class="mt-3 whitespace-pre-line">
          {descriptionSegments.length === 0 ? (
            'No description available in the current extraction output.'
          ) : (
            descriptionSegments.map((segment) => (
              <span class={getDescriptionSegmentClass(segment.colorCode)}>{segment.text}</span>
            ))
          )}
        </p>
      </div>
    </section>

    <section class="panel">
      <h2 class="text-lg">How to Obtain</h2>
      {groupedMethods.length === 0 && monsterRankGroups.length === 0 ? (
        <p class="mt-3 text-slate-300">No acquisition data available yet.</p>
      ) : (
        <div class="mt-4 space-y-5">
          {monsterRankGroups.map((rankGroup) => (
            <section class="space-y-2">
              <h3 class="text-base text-slate-200">
                {(rankLabels[rankGroup.rank] || rankGroup.rank.toUpperCase())} - Monster Sources
              </h3>
              <div class="space-y-3 text-slate-300">
                {rankGroup.monsters.map((monsterGroup) => (
                  <section class="space-y-1">
                    <h4 class="text-sm">
                      {typeof monsterGroup.monsterId === 'number' ? (
                        <a
                          href={withBase(`monster-drops/${monsterGroup.monsterId}/`)}
                          class="hover:text-white"
                        >
                          {monsterGroup.monsterName}
                        </a>
                      ) : (
                        <span class="text-slate-200">{monsterGroup.monsterName}</span>
                      )}
                    </h4>
                    <ul class="list-disc space-y-1 pl-5">
                      {monsterGroup.methods.map((method) => (
                        <li>
                          <span class="text-slate-200">{getMonsterMethodLabel(method)}</span>
                          {' - '}
                          <span>{typeof method.chance === 'number' ? `${method.chance}%` : 'Unknown chance'}</span>
                          {' x'}
                          <span>{typeof method.quantity === 'number' ? method.quantity : '?'}</span>
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            </section>
          ))}
          {groupedMethods.map((group) => (
            <section class="space-y-2">
              <h3 class="text-base text-slate-200">
                {(rankLabels[group.rank] || group.rank.toUpperCase())} - {methodLabels[group.methodType] || group.methodType}
              </h3>
              {group.methodType === 'quest_reward' ? (
                <div class="space-y-3 text-slate-300">
                  {groupQuestRewardsByQuest(group.methods).map((questGroup) => {
                    const questHref = questGroup.questSlug ? withBase(`quests/${questGroup.questSlug}/`) : null;
                    const questIdLabel = typeof questGroup.questId === 'number' ? ` (#${questGroup.questId})` : '';
                    return (
                      <section class="space-y-1">
                        <h4 class="text-sm text-slate-200">
                          {questHref ? (
                            <a href={questHref} class="hover:text-white">
                              {questGroup.questTitle}{questIdLabel}
                            </a>
                          ) : (
                            <span>{questGroup.questTitle}{questIdLabel}</span>
                          )}
                        </h4>
                        <ul class="list-disc space-y-1 pl-5">
                          {questGroup.methods.map((method) => (
                            <li>
                              <span class="text-slate-200">
                                {getRewardBoxLabel(method)}
                              </span>
                              {' - '}
                              <span>{typeof method.chance === 'number' ? `${method.chance}%` : 'Unknown chance'}</span>
                              {' x'}
                              <span>{typeof method.quantity === 'number' ? method.quantity : '?'}</span>
                            </li>
                          ))}
                        </ul>
                      </section>
                    );
                  })}
                </div>
              ) : (
                <ul class="list-disc space-y-1 pl-5 text-slate-300">
                  {group.methods.map((method) => (
                    <li>
                      {getSourceHref(method) ? (
                        <a href={getSourceHref(method) || undefined} class="text-slate-200 hover:text-white">
                          {renderSourceLabel(method)}
                        </a>
                      ) : (
                        <span class="text-slate-200">{renderSourceLabel(method)}</span>
                      )}
                      {' - '}
                      <span>{typeof method.chance === 'number' ? `${method.chance}%` : 'Unknown chance'}</span>
                      {' x'}
                      <span>{typeof method.quantity === 'number' ? method.quantity : '?'}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))}
        </div>
      )}
    </section>
  </article>
</WikiLayout>
