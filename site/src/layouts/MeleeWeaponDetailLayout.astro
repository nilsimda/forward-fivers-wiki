---
import WikiLayout from "./WikiLayout.astro";

interface Props {
  title: string;
  weaponName: string;
  classDisplayName: string;
  /** Path under site root, e.g. `weapons/great-sword/` */
  classIndexPath: string;
}

const { title, weaponName, classDisplayName, classIndexPath } =
  Astro.props as Props;

const baseUrl = import.meta.env.BASE_URL;
const basePath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const withBase = (targetPath: string) =>
  `${basePath}${targetPath.replace(/^\//, "")}`;

const classIndexHref = withBase(classIndexPath);
---

<WikiLayout title={title}>
  <section class="space-y-2">
    <p class="text-sm text-slate-400">
      <a href={withBase("weapons/")}>Weapons</a>
      <span class="text-slate-600"> / </span>
      <a href={classIndexHref}>{classDisplayName}</a>
    </p>
    <h1>{weaponName}</h1>
    <p class="text-slate-400">{classDisplayName}</p>
  </section>
  <slot />
</WikiLayout>
