---
import type { CollectionEntry } from "astro:content";
import fs from "node:fs";

type GatheringMapData = CollectionEntry<"gathering">["data"];
type GatheringRankKey = keyof GatheringMapData["ranks"];
type GatheringAreaData = NonNullable<GatheringMapData["ranks"][GatheringRankKey]>[number];
type GatheringPointData = GatheringAreaData["gps"][number];

interface Props {
  rank: GatheringRankKey;
  rankLabel: string;
  areas: GatheringAreaData[];
  mapSlug: string;
  time: "day" | "night";
  withBase: (targetPath: string) => string;
}

const { rank, rankLabel, areas, mapSlug, time, withBase } = Astro.props as Props;

const formatCountRange = (point: GatheringPointData) =>
  point.min_count === point.max_count
    ? String(point.min_count)
    : `${point.min_count}-${point.max_count}`;

const resolveAreaImage = (area: number): string | null => {
  const base = `public/img/gathering/${mapSlug}/area-${area}`;
  const timePath = `${base}-${time}.png`;
  if (fs.existsSync(timePath)) return withBase(`img/gathering/${mapSlug}/area-${area}-${time}.png`);
  const shared = `${base}.png`;
  if (fs.existsSync(shared)) return withBase(`img/gathering/${mapSlug}/area-${area}.png`);
  return null;
};

const mapHasAnyImages = areas.some((a) => resolveAreaImage(a.area) !== null);

const areaLabel = (area: number) => (area === 0 ? "Base Camp" : `Area ${area}`);

const grouped = areas.map((area, i) => ({
  area: area.area,
  points: area.gps.map((point, j) => ({ pointNumber: j + 1, point })),
  isSecret: mapHasAnyImages && i === areas.length - 1 && resolveAreaImage(area.area) === null,
  imageSrc: resolveAreaImage(area.area),
}));
---
<div class="space-y-0">
  {grouped.map((group, idx) => (
    <details
      class="border-b border-slate-700 last:border-b-0"
      open={idx === 0}
    >
      <summary class="cursor-pointer list-none py-3 pr-2 font-medium text-lg text-slate-100 marker:hidden [&::-webkit-details-marker]:hidden hover:text-white">
        {group.isSecret ? `${areaLabel(group.area)} (Secret)` : areaLabel(group.area)}
      </summary>
      <div class="pb-4 pt-1">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
          {group.imageSrc && (
            <img
              src={group.imageSrc}
              alt={`${areaLabel(group.area)} map`}
              class="w-full shrink-0 rounded border border-slate-700 sm:w-36"
              loading="lazy"
            />
          )}
          <div class="min-w-0 flex-1">
            <table class="table-grid">
              <thead>
                <tr>
                  <th>Node</th>
                  <th>Node Health</th>
                  <th>Drops</th>
                </tr>
              </thead>
              <tbody>
                {group.points.map(({ pointNumber, point }) => (
                  <tr>
                    <td>#{pointNumber}</td>
                    <td>{formatCountRange(point)}x</td>
                    <td>
                      <ul class="list-disc space-y-1 pl-5">
                        {point.drops.map((drop) => (
                          <li>
                            {drop.item_id === 65535 ? (
                              drop.item_name
                            ) : (
                              <a href={withBase(`items/${drop.item_id}/`)}>{drop.item_name}</a>
                            )}
                            <span class="text-slate-300"> - {drop.percentage}%</span>
                          </li>
                        ))}
                      </ul>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </details>
  ))}
</div>
