---
import type { CollectionEntry } from "astro:content";

type MonsterCarves = CollectionEntry<"monsterCarves">;
type MonsterPartbreaks = CollectionEntry<"monsterPartbreaks">;

interface Props {
  rank: "lr" | "hr" | "er" | "gr";
  rankLabel: string;
  monsterId: string;
  carves: MonsterCarves;
  partbreaks: MonsterPartbreaks | undefined;
  withBase: (targetPath: string) => string;
}

const { rank, rankLabel, monsterId, carves, partbreaks, withBase } = Astro.props as Props;

const availabilityWarnings: Record<
  string,
  {
    monsterName: string;
    hrRequirementByRank: Partial<Record<Props["rank"], number>>;
  }
> = {
  "76": {
    monsterName: "Tigrex",
    hrRequirementByRank: { lr: 51, hr: 71 },
  },
  "78": {
    monsterName: "Vivid Hypnocatrice",
    hrRequirementByRank: { lr: 31, hr: 51 },
  },
};

const warningConfig = availabilityWarnings[monsterId];
const requiredHr = warningConfig?.hrRequirementByRank[rank];
const inaccessibleTierLabelByRank: Record<Props["rank"], string> = {
  lr: "Low Rank",
  hr: "High Rank",
  er: "Elite Rank",
  gr: "G-Rank",
};
const carveKey = `${rank}_cts` as const;
const partbreakKey = `${rank}_pts` as const;

const carveTables = carves.data[carveKey];
const partbreakTables = partbreaks?.data[partbreakKey] ?? [];
---

<section class={`panel rank-panel rank-panel--${rank}`}>
  <header class="mb-3 flex items-center justify-between gap-3">
    <h2 class="text-lg">{rankLabel}</h2>
  </header>
  {warningConfig && requiredHr && (
    <p class="mb-3 rounded border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-sm text-amber-300">
        ⚠️ {inaccessibleTierLabelByRank[rank]} {warningConfig.monsterName} is only available from HR {requiredHr} onwards
      — these drops are not accessible in standard {inaccessibleTierLabelByRank[rank]}.
    </p>
  )}
  <div class="table-wrap">
    <table class="table-grid">
      <thead>
        <tr>
          <th>Drop origin</th>
          <th>Drops</th>
        </tr>
      </thead>
      <tbody>
        {
          carveTables.map((ct) => (
            <tr>
              <td>
                {ct.label}
                {ct.label !== "HC Carve" &&
                  ` x ${ct.num_carves ?? `${ct.trigger_chance}%`}`}
              </td>
              <td>
                {ct.drops.map((drop) => (
                  <ul class="list-disk space-y-1 pl-5">
                    <li>
                      <a
                        href={withBase(`items/${drop.item_id}/`)}
                        class="font-medium text-slate-200 hover:text-white"
                      >
                        {drop.item_name}
                      </a>
                      <span class="text-slate-300"> - {drop.percentage}%</span>
                    </li>
                  </ul>
                ))}
              </td>
            </tr>
          ))
        }
        {
          partbreakTables.map((pt) => (
            <tr>
              <td>
                {pt.partbreak_label === "Capture"
                  ? pt.partbreak_label
                  : "Part Break:" + pt.partbreak_label}
              </td>
              <td>
                {pt.drops.map((drop) => (
                  <ul class="list-disk space-y-1 pl-5">
                    <li>
                      <a
                        href={withBase(`items/${drop.item_id}/`)}
                        class="font-medium text-slate-200 hover:text-white"
                      >
                        {drop.item_name}
                      </a>
                      <span class="text-slate-300"> - {drop.percentage}%</span>{" "}
                      x {drop.quantity}
                    </li>
                  </ul>
                ))}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
