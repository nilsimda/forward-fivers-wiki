---
import EquipTypeTag from "./EquipTypeTag.astro";
import { type RangedWeapon, getRangedWeaponsById } from "../lib/rangedWeapons";
import { weaponClasses } from "../data/weaponClasses";

interface Props {
  weapon: RangedWeapon;
}

const { weapon } = Astro.props as Props;

const byId = await getRangedWeaponsById();

const branchesFrom = [...byId.values()].filter(
  (w) => w.upgrade_entry?.upgrades_to.includes(weapon.id) ?? false,
);

const baseUrl = import.meta.env.BASE_URL;
const basePath = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const withBase = (targetPath: string) =>
  `${basePath}${targetPath.replace(/^\//, "")}`;

const slugByClassName = new Map(
  weaponClasses.map((c) => [c.name, c.slug] as const),
);

const hrefForWeapon = (w: RangedWeapon) => {
  const slug = slugByClassName.get(w.class_name);
  return slug ? withBase(`weapons/${slug}/${w.id}/`) : withBase("weapons/");
};

const descColorClasses: Record<string, string> = {
  "02": "text-red-400",
  "03": "text-emerald-400",
  "05": "text-amber-300",
  "07": "text-pink-400",
  "11": "text-rose-400",
  "16": "text-sky-400",
};
const segmentClass = (code: string | null) =>
  code && descColorClasses[code] ? descColorClasses[code] : "text-slate-300";

const fmtElem = (w: RangedWeapon) =>
  w.element ? `${w.element} ${w.element_damage}` : "—";
const fmtSlots = (w: RangedWeapon) =>
  w.slots === 0 ? "—" : "○".repeat(w.slots);
const fmtAffinity = (w: RangedWeapon) =>
  w.affinity === 0 ? "0%" : `${w.affinity > 0 ? "+" : ""}${w.affinity}%`;

const BASE_SUCCESS_RATE: Record<number, number> = {
  2: 100, 3: 100, 4: 100, 5: 100, 6: 100, 7: 100, 8: 100, 9: 100, 10: 100,
  11: 70, 12: 60, 13: 50, 14: 100, 15: 30, 16: 30, 17: 30, 18: 100, 19: 20, 20: 10,
};
const RECIPE2_BONUS = 10;

const grankRows = (weapon.grank_upgrades?.recipe1 ?? []).map((entry) => {
  const base = BASE_SUCCESS_RATE[entry.level] ?? 100;
  const r2 = weapon.grank_upgrades?.recipe2 ?? null;
  const r2Applies = r2 !== null
    && entry.level - r2.level_min >= 0
    && r2.level_max - entry.level >= 0;
  return {
    entry,
    base,
    withBonus: Math.min(100, base + RECIPE2_BONUS),
    r2: r2Applies ? r2 : null,
  };
});

const r2Range = weapon.grank_upgrades?.recipe2 ?? null;
const r2RangePartial = r2Range !== null && r2Range.level_min - 2 > 0;
---

{weapon.descriptionSegments.length > 0 && (
  <section class="panel mt-6">
    <h2 class="text-lg">Description</h2>
    <p class="mt-3 whitespace-pre-line">
      {weapon.descriptionSegments.map((seg) => (
        <span class={segmentClass(seg.colorCode)}>{seg.text}</span>
      ))}
    </p>
  </section>
)}

<section class="panel mt-6">
  <h2 class="text-lg">Stats</h2>
  <div class="table-wrap mt-4">
    <table class="table-grid">
      <thead>
        <tr>
          <th>Raw</th>
          <th>Aff.</th>
          <th>Element</th>
          <th>Slots</th>
          <th>Recoil</th>
          <th>Reload</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>{weapon.raw_damage}</td>
          <td class="tabular-nums">{fmtAffinity(weapon)}</td>
          <td class="whitespace-nowrap">{fmtElem(weapon)}</td>
          <td class="font-mono text-slate-200">{fmtSlots(weapon)}</td>
          <td class="whitespace-nowrap">{weapon.recoil}</td>
          <td class="whitespace-nowrap">{weapon.reload_speed}</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

{weapon.crafting?.purchasable && (
  <section class="panel mt-6">
    <h2 class="text-lg">Purchase</h2>
    <p class="mt-3 text-slate-300">
      Price: <span class="tabular-nums">{weapon.price}</span>z
    </p>
  </section>
)}

{weapon.crafting && weapon.crafting.material_costs.length > 0 && (
  <section class="panel mt-6">
    <h2 class="text-lg">Craft at the Smithy</h2>
    <ul class="mt-3 list-inside list-disc space-y-1 text-slate-300">
      {weapon.crafting.material_costs.map((cost) => (
        <li>
          <a
            class="text-cyan-300 hover:text-cyan-200"
            href={withBase(`items/${cost.item_id}/`)}
          >
            {cost.item_name}
          </a>
          <span class="text-slate-300"> {cost.amount}</span>
        </li>
      ))}
    </ul>
  </section>
)}

{weapon.upgrade_entry && weapon.upgrade_entry.material_costs.length > 0 && (
  <section class="panel mt-6">
    <h2 class="text-lg">Craft via Upgrade</h2>
    <ul class="mt-3 list-inside list-disc space-y-1 text-slate-300">
      {weapon.upgrade_entry.material_costs.map((cost) => (
        <li>
          <a
            class="text-cyan-300 hover:text-cyan-200"
            href={withBase(`items/${cost.item_id}/`)}
          >
            {cost.item_name}
          </a>
          <span class="text-slate-300"> - {cost.amount}x</span>
        </li>
      ))}
    </ul>
  </section>
)}

{branchesFrom.length > 0 && (
  <section class="panel mt-6">
    <h2 class="text-lg">Branches from</h2>
    <ul class="mt-3 list-inside list-disc space-y-1 text-slate-300">
      {branchesFrom.map((prev) => (
        <li>
          <a href={hrefForWeapon(prev)}>{prev.name}</a>
          <EquipTypeTag equipType={prev.equip_type} />
          <span class="text-slate-500"> — {prev.class_name}</span>
        </li>
      ))}
    </ul>
  </section>
)}

{weapon.grank_upgrades && (
  <section class="panel mt-6">
    <h2 class="text-lg">G Rank Upgrades</h2>
    <p class="mt-3 text-sm text-slate-400">
      Pick one recipe per upgrade. Recipe 2 uses a single rare G Rank material instead of Recipe 1's mats and grants a flat +{RECIPE2_BONUS}% to the base success rate
      {r2RangePartial && r2Range && (
        <span> (only available from Lv {r2Range.level_min}–{r2Range.level_max})</span>
      )}
      .
    </p>
    <div class="table-wrap mt-4">
      <table class="table-grid">
        <thead>
          <tr>
            <th>Lv</th>
            <th>Success</th>
            <th>Recipe 1</th>
            <th>Recipe 2</th>
          </tr>
        </thead>
        <tbody>
          {grankRows.map((row) => (
            <tr>
              <td class="tabular-nums">{row.entry.level}</td>
              <td class="tabular-nums whitespace-nowrap">
                <div>R1: {row.base}%</div>
                {row.r2 && (
                  <div class="text-slate-400">R2: {row.withBonus}%</div>
                )}
              </td>
              <td>
                <div class="text-xs text-slate-500"><span class="tabular-nums">{row.entry.price}</span>Gz</div>
                <ul class="list-inside list-disc space-y-0.5 text-slate-300">
                  {row.entry.material_costs.map((cost) => (
                    <li>
                      <a class="text-cyan-300 hover:text-cyan-200" href={withBase(`items/${cost.item_id}/`)}>{cost.item_name}</a>
                      <span class="text-slate-300"> ×{cost.amount}</span>
                    </li>
                  ))}
                </ul>
              </td>
              <td>
                {row.r2 ? (
                  <div>
                    <div class="text-xs text-slate-500"><span class="tabular-nums">{row.r2.price}</span>Gz</div>
                    <ul class="list-inside list-disc space-y-0.5 text-slate-300">
                      {row.r2.material_costs.map((cost) => (
                        <li>
                          <a class="text-cyan-300 hover:text-cyan-200" href={withBase(`items/${cost.item_id}/`)}>{cost.item_name}</a>
                          <span class="text-slate-300"> ×{cost.amount}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ) : (
                  <span class="text-slate-600">—</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}

<section class="panel mt-6">
  <h2 class="text-lg">Branches to</h2>
  {(weapon.upgrade_entry?.upgrades_to.length ?? 0) === 0 ? (
    <p class="mt-3 text-slate-400">No further upgrades in data.</p>
  ) : (
    <ul class="mt-3 list-inside list-disc space-y-1 text-slate-300">
      {(weapon.upgrade_entry?.upgrades_to ?? []).map((id) => {
        const next = byId.get(id);
        return (
          <li>
            {next ? (
              <a href={hrefForWeapon(next)}>{next.name}</a>
            ) : (
              <span>#{id} (missing)</span>
            )}
            {next && <EquipTypeTag equipType={next.equip_type} />}
            {next && <span class="text-slate-500"> — {next.class_name}</span>}
          </li>
        );
      })}
    </ul>
  )}
</section>
