---
interface Props {
  equipType: string;
}

const { equipType } = Astro.props as Props;

const variantByType: Record<string, string> = {
  Mighty: "equip-tag--mighty",
  Heavenly: "equip-tag--heavenly",
  Supreme: "equip-tag--supreme",
  HC: "equip-tag--hc",
  SP: "equip-tag--sp",
  Evolving: "equip-tag--evolution",
  Meowty: "equip-tag--mighty",
  Artisanal: "equip-tag--artisanal",
  "G-rank": "equip-tag--grank",
};

const variant = variantByType[equipType];
---

{variant && (
  <span class={`equip-tag ${variant}`}>{equipType}</span>
)}
